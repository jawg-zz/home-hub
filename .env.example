# Database configuration
# PostgreSQL (production and local development)
DATABASE_URL="postgresql://postgres:postgres@home-db:5432/homehub"

# PostgreSQL password (for Docker Compose)
POSTGRES_PASSWORD="postgres"

# NextAuth.js configuration
# IMPORTANT: Generate a secure secret for production using: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Allowed CORS origins (comma-separated)
# ALLOWED_ORIGINS="http://localhost:3000"
