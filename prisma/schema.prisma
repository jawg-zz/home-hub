generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  avatar    String?
  role      String   @default("viewer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chores    Chore[]  @relation("ChoreOwner")
  assignedChores Chore[] @relation("AssignedUser")
  devices   Device[]
  shopping  ShoppingItem[]
  cameras  Camera[]
  locks    Lock[]
  alerts   SecurityAlert[]
}

model Device {
  id        String   @id @default(cuid())
  name      String
  type      String
  room      String
  status    String   @default("offline")
  value     Int      @default(0)
  online    Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([room])
  @@index([online])
  @@index([status])
}

model ShoppingItem {
  id        String   @id @default(cuid())
  name      String
  quantity  String?
  checked   Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([checked])
}

model Chore {
  id           String    @id @default(cuid())
  title        String
  assignedTo   String?
  assignedUser User?     @relation("AssignedUser", fields: [assignedTo], references: [id])
  dueDate      DateTime?
  completed    Boolean   @default(false)
  userId       String?
  user         User?     @relation("ChoreOwner", fields: [userId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([completed])
  @@index([dueDate])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EnergyReading {
  id        String   @id @default(cuid())
  date      DateTime
  usage     Float
  cost      Float
  createdAt DateTime @default(now())

  @@index([date])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model HomeAssistantConfig {
  id          String   @id @default(cuid())
  userId      String   @unique
  haUrl       String?
  haToken     String?
  isConnected Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Camera {
  id        String   @id @default(cuid())
  name      String
  location  String
  status    String   @default("offline")
  streamUrl String?
  thumbnail String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Lock {
  id          String   @id @default(cuid())
  name        String
  location    String
  status      String   @default("locked")
  lastActivity DateTime?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model SecurityAlert {
  id        String   @id @default(cuid())
  type      String
  message   String
  source    String?
  read      Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}
